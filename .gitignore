storage/audio/*.wav
storage/midi/*.mid

# Frontend dependencies and builds
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and secrets
.env
.env.local
.env.*.local

# Editor and OS caches
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
